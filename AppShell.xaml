<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Calculatrice.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CalculatriceMaui"
    Title="Calculatrice">

    <TabBar>
        <ShellContent Title="Standard" Icon="calculator.png"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="standard" />
        <ShellContent Title="Scientifique" Icon="scientifique.png"
                      ContentTemplate="{DataTemplate local:ScientificPage}"
                      Route="scientifique" />
    </TabBar>

</Shell>
